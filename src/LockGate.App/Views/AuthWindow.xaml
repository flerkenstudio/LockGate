<Window x:Class="LockGate.App.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LockGate Authentication"
        Height="490" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <!-- Translucent Frosted Acrylic Border in Light Theme -->
    <Border Background="#F7F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="1.5"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="40" ShadowDepth="8" Opacity="0.12" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- App Info -->
                <RowDefinition Height="*" />    <!-- Dynamic Body (Hello or PIN) -->
                <RowDefinition Height="Auto" /> <!-- Error Status -->
                <RowDefinition Height="Auto" /> <!-- Actions & Footer -->
            </Grid.RowDefinitions>

            <!-- Header with Shield / Hello Icon -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border x:Name="HeaderBadge" Width="64" Height="64" CornerRadius="32" Background="#EFF6FF" BorderBrush="#2563EB" BorderThickness="2" HorizontalAlignment="Center">
                    <Image Source="/LockGate.App;component/Assets/logo_symbol.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="HeaderTitle" Text="Windows Hello" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,10,0,2" />
                <TextBlock x:Name="HeaderSubtitle" Text="Verify your identity to unlock" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- App info -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                <TextBlock x:Name="AppNameText" Text="Application: chrome.exe" Foreground="#2563EB" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Mode 1: Windows Hello Panel -->
            <StackPanel x:Name="HelloPanel" Grid.Row="2" VerticalAlignment="Center" Visibility="Visible">
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Windows Biometric Security" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Unlock using Windows facial recognition, fingerprint, or system PIN." FontSize="11" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                    </StackPanel>
                </Border>

                <Button x:Name="VerifyHelloButton"
                        Content="👤 Unlock with Windows Hello"
                        Height="46"
                        Style="{DynamicResource ActionButtonPrimary}"
                        Click="WindowsHello_Click" />
            </StackPanel>

            <!-- Mode 2: Master PIN Panel -->
            <StackPanel x:Name="PinPanel" Grid.Row="2" VerticalAlignment="Center" Visibility="Collapsed">
                <PasswordBox x:Name="PinBox"
                             Height="42"
                             FontSize="20"
                             FontWeight="Bold"
                             Foreground="#0F172A"
                             Background="#FFFFFF"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1.5"
                             Padding="12,6"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             PasswordChanged="PinBox_PasswordChanged"
                             Margin="0,0,0,10" />

                <!-- Keypad -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />

                    <Button Grid.Row="3" Grid.Column="0" Content="CLR" FontSize="11" FontWeight="Bold" Style="{DynamicResource ActionButtonSecondary}" Click="Clear_Click" />
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                    <Button Grid.Row="3" Grid.Column="2" Content="↵" FontSize="16" FontWeight="Bold" Style="{DynamicResource ActionButtonPrimary}" Click="Unlock_Click" />
                </Grid>
            </StackPanel>

            <!-- Status / Error message -->
            <TextBlock x:Name="StatusMessage"
                       Grid.Row="3"
                       Text=""
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#DC2626"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Margin="0,6,0,8" />

            <!-- Footer: Switch Mode & Cancel -->
            <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Orientation="Vertical">
                <Button x:Name="SwitchModeButton"
                        Content="Switch to Master PIN"
                        Height="28"
                        Style="{DynamicResource GhostButton}"
                        Margin="0,0,0,4"
                        Click="SwitchMode_Click"
                        Visibility="Collapsed" />

                <Button Content="Cancel &amp; Keep Locked"
                        Height="32"
                        Style="{DynamicResource GhostButton}"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>

    <Window.Resources>
        <Style x:Key="KeypadButton" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonPrimary" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonSecondary" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>

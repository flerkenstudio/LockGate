<Window x:Class="FaceGate.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaceGate - Windows Application Locker"
        Height="640" Width="820"
        MinHeight="550" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Tab Button Style -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Bar -->
            <RowDefinition Height="Auto" /> <!-- Navigation -->
            <RowDefinition Height="*" />    <!-- Content Tab -->
            <RowDefinition Height="Auto" /> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#182234" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title & Status Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#2563EB" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FaceGate" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="for Windows" FontSize="13" Foreground="#94A3B8" Margin="6,3,0,0" />
                        </StackPanel>
                        <TextBlock Text="Native Application Locker &amp; Security Shield" FontSize="11" Foreground="#64748B" />
                    </StackPanel>

                    <!-- Status Pill -->
                    <Border x:Name="StatusPill" CornerRadius="12" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" Padding="10,4" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusPillText" Text="● Protection Active" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PauseResumeButton" Content="⏸ Pause 5m" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="PauseResume_Click" />
                    <Button Content="🔒 Lock All" Style="{StaticResource PrimaryButton}" Click="LockAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Tabs -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabApps" Content="🛡️ Protected Applications" Style="{StaticResource NavTabStyle}" IsChecked="True" Checked="NavTab_Checked" />
                <RadioButton x:Name="TabSecurity" Content="🔑 Master PIN &amp; Security" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked" />
                <RadioButton x:Name="TabSettings" Content="⚙️ Settings" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="20">
            <!-- Tab 1: Protected Apps -->
            <Grid x:Name="AppsView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Add Application Card -->
                <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Protect New Application" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,12" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Process Picker -->
                            <ComboBox x:Name="ProcessPickerCombo"
                                      Grid.Column="0"
                                      Height="36"
                                      Margin="0,0,8,0"
                                      VerticalContentAlignment="Center"
                                      Background="#0F172A"
                                      Foreground="#F8FAFC"
                                      DropDownOpened="ProcessPicker_DropDownOpened" />

                            <!-- Browse Button -->
                            <Button Grid.Column="1" Content="📁 Browse .exe" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0" Click="BrowseExe_Click" />

                            <!-- Session Mode -->
                            <ComboBox x:Name="SessionModeCombo"
                                      Grid.Column="2"
                                      Height="36"
                                      Margin="0,0,8,0"
                                      VerticalContentAlignment="Center"
                                      Background="#0F172A"
                                      Foreground="#F8FAFC"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="Lock Immediately" />
                                <ComboBoxItem Content="1 Minute Session" />
                                <ComboBoxItem Content="5 Minutes Session" />
                                <ComboBoxItem Content="15 Minutes Session" />
                                <ComboBoxItem Content="30 Minutes Session" />
                                <ComboBoxItem Content="Indefinite (Until closed)" />
                            </ComboBox>

                            <!-- Add Button -->
                            <Button Grid.Column="3" Content="+ Protect App" Style="{StaticResource PrimaryButton}" Height="36" Click="AddApp_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Protected Apps List -->
                <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Protected Applications List" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" />
                            <TextBlock x:Name="AppsCountText" Text="(0 guarded)" FontSize="12" Foreground="#94A3B8" Margin="8,2,0,0" />
                        </StackPanel>

                        <!-- Apps ItemsControl / ScrollViewer -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AppsContainer" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Tab 2: Security & PIN -->
            <Grid x:Name="SecurityView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <!-- Master PIN Configuration Card -->
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Master PIN Authentication" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                <TextBlock Text="This PIN is used to unlock protected applications and modify settings." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16" />

                                <TextBlock Text="New PIN (4-12 digits):" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6" />
                                <PasswordBox x:Name="NewPinBox" Height="36" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="8,4" />

                                <TextBlock Text="Confirm New PIN:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6" />
                                <PasswordBox x:Name="ConfirmPinBox" Height="36" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" Margin="0,0,0,16" VerticalContentAlignment="Center" Padding="8,4" />

                                <TextBlock x:Name="PinStatusMessage" Text="" FontSize="12" FontWeight="Medium" Foreground="#10B981" Margin="0,0,0,12" />

                                <Button Content="Set Master PIN" Style="{StaticResource PrimaryButton}" Height="36" HorizontalAlignment="Left" Click="SavePin_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Windows Hello Card -->
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Windows Hello Biometrics / PIN" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                <TextBlock Text="Authenticate seamlessly using Windows Hello face, fingerprint, or system PIN." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Availability: " FontSize="13" Foreground="#CBD5E1" />
                                    <TextBlock x:Name="WindowsHelloStatusText" Text="Checking..." FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" />
                                </StackPanel>

                                <Button Content="Test Windows Hello Prompt" Style="{StaticResource SecondaryButton}" Height="36" HorizontalAlignment="Left" Click="TestHello_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Cryptography Architecture Card -->
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Security Standards &amp; Architecture" FontSize="14" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,8" />
                                <TextBlock Text="• Verifier KDF: PBKDF2-HMAC-SHA-256 with 600,000 iterations (OWASP compliant)" FontSize="12" Foreground="#94A3B8" Margin="0,2" />
                                <TextBlock Text="• Storage: Encrypted via Windows DPAPI (CurrentUser Scope, pin.dat)" FontSize="12" Foreground="#94A3B8" Margin="0,2" />
                                <TextBlock Text="• Rate Limiting: 5 free attempts followed by exponential backoff lockout up to 15 min" FontSize="12" Foreground="#94A3B8" Margin="0,2" />
                                <TextBlock Text="• Session Clock: Monotonic TimeProvider (resists Windows clock tampering)" FontSize="12" Foreground="#94A3B8" Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Tab 3: Settings -->
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Application Settings" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,16" />

                                <TextBlock Text="Default Session Length for New Apps:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,6" />
                                <ComboBox x:Name="DefaultSessionCombo" Height="36" Width="220" HorizontalAlignment="Left" Background="#0F172A" Foreground="#F8FAFC" VerticalContentAlignment="Center" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Lock Immediately" />
                                    <ComboBoxItem Content="1 Minute" />
                                    <ComboBoxItem Content="5 Minutes (Default)" />
                                    <ComboBoxItem Content="15 Minutes" />
                                    <ComboBoxItem Content="30 Minutes" />
                                    <ComboBoxItem Content="Keep Unlocked" />
                                </ComboBox>

                                <CheckBox x:Name="LockOnWindowsLockCheck" Content="Lock all applications when Windows workstation locks (Win+L) or sleeps" Foreground="#F8FAFC" FontSize="13" IsChecked="True" Margin="0,0,0,16" />

                                <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to System Tray when window is closed (keeps FaceGate running)" Foreground="#F8FAFC" FontSize="13" IsChecked="True" Margin="0,0,0,20" />

                                <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" Height="36" HorizontalAlignment="Left" Click="SaveSettings_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Footer -->
        <Border Grid.Row="3" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterInfoText" Text="FaceGate Active • Monitoring foreground processes • System Tray enabled" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="v1.0.0 (Windows Native)" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="FaceGate.App.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaceGate Authentication"
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Border Background="#121826"
            BorderBrush="#334155"
            BorderThickness="1.5"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.75" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- App Info -->
                <RowDefinition Height="Auto" /> <!-- PIN Input -->
                <RowDefinition Height="Auto" /> <!-- Keypad -->
                <RowDefinition Height="Auto" /> <!-- Error Status -->
                <RowDefinition Height="*" />    <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Header with Shield -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border Width="60" Height="60" CornerRadius="30" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2" HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="FaceGate Security" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,10,0,2" />
                <TextBlock Text="Application Locked" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- App info -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12,8" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                <TextBlock x:Name="AppNameText" Text="Application: chrome.exe" Foreground="#38BDF8" FontWeight="Medium" FontSize="13" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- PIN Input -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <PasswordBox x:Name="PinBox"
                             Height="44"
                             FontSize="20"
                             FontWeight="Bold"
                             Foreground="#F8FAFC"
                             Background="#0F172A"
                             BorderBrush="#475569"
                             BorderThickness="1.5"
                             Padding="12,6"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             PasswordChanged="PinBox_PasswordChanged" />
            </StackPanel>

            <!-- Keypad -->
            <Grid Grid.Row="3" Margin="0,4,0,8" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="46" />
                    <RowDefinition Height="46" />
                    <RowDefinition Height="46" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />

                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />

                <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />

                <Button Grid.Row="3" Grid.Column="0" Content="CLR" FontSize="11" FontWeight="Bold" Style="{DynamicResource ActionButtonSecondary}" Click="Clear_Click" />
                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{DynamicResource KeypadButton}" Click="Digit_Click" />
                <Button Grid.Row="3" Grid.Column="2" Content="↵" FontSize="16" FontWeight="Bold" Style="{DynamicResource ActionButtonPrimary}" Click="Unlock_Click" />
            </Grid>

            <!-- Status / Error message -->
            <TextBlock x:Name="StatusMessage"
                       Grid.Row="4"
                       Text=""
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#EF4444"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Margin="0,4,0,8" />

            <!-- Windows Hello & Cancel -->
            <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Orientation="Vertical">
                <Button x:Name="WindowsHelloButton"
                        Content="👤 Unlock with Windows Hello"
                        Height="36"
                        Margin="0,0,0,8"
                        Style="{DynamicResource ActionButtonSecondary}"
                        Click="WindowsHello_Click"
                        Visibility="Collapsed" />

                <Button Content="Cancel &amp; Keep Locked"
                        Height="32"
                        Style="{DynamicResource GhostButton}"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>

    <Window.Resources>
        <Style x:Key="KeypadButton" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#475569" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonPrimary" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonSecondary" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Background" Value="#334155" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F1F5F9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
